{
  "name": "campusconnect",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-safe.ps1",
    "db:test:status": "node scripts/test-db.mjs status",
    "db:test:deploy": "node scripts/test-db.mjs deploy",
    "test:integration": "node scripts/test-db.mjs integration",
    "db:studio": "prisma studio",
    "bootstrap:platform-admin": "node scripts/bootstrap-platform-admin.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12",
    "@prisma/adapter-pg": "^7.10.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "@prisma/client": "^7.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.6",
    "autoprefixer": "^10.4.21",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1"
  },
  "type": "module"
}

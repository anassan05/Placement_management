# Local PostgreSQL example. Replace credentials for your machine.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/campusconnect?schema=public"
APP_DATABASE_URL="postgresql://APP_USER:APP_PASSWORD@localhost:5432/campusconnect?schema=public"
APP_URL="http://localhost:3000"
NODE_ENV="development"
TRUSTED_HOSTS="localhost,127.0.0.1"
STUDENT_IMPORT_MAX_BYTES="1048576"
STUDENT_IMPORT_MAX_ROWS="500"
PRIVATE_STORAGE_ROOT="./.private-storage"
STUDENT_DOCUMENT_MAX_BYTES="10485760"
